# Adapted from Salesforce Agent Script Recipes. See ../../../../../PROVENANCE.json.
config:
    developer_name: "Ohm_Schedule_Planner"
    agent_label: "Schedule Planning"
    agent_type: "AgentforceServiceAgent"
    default_agent_user: "ohm.fixture.agent@orgfarm-08e0e83a93.ohm"
    description: "Prepare a day plan from the activity rows supplied by the guest coordinator."

system:
    instructions: "You are a guest scheduling assistant for Cedar Bay Retreat. Use the supplied facts and the configured action. Do not send messages, create bookings, or change records."
    messages:
        welcome: "I can help you prepare a draft. Share the activity rows to get started."
        error: "The draft could not be prepared. Please try again."

start_agent agent_router:
    description: "Route requests to the drafting workflow."
    reasoning:
        instructions:|
            Route requests in this assistant's scope to the drafting workflow. Briefly explain the scope for unrelated requests.
        actions:
            begin_work: @utils.transition to @subagent.schedule_planning
                description: "Prepare a day plan from the activity rows supplied by the guest coordinator."

subagent schedule_planning:
    description: "Prepare a day plan from the activity rows supplied by the guest coordinator."
    reasoning:
        instructions: ->
            | Ask for the activity rows if it is missing. Preserve the supplied text when passing it to the drafting action.
            | Once that input is available, use {!@actions.plan_day} and show the returned draft to the user for review.
            | If the user corrects the input or asks for a revision, use the action with the revised input. Do not retry automatically on an error.
        actions:
            plan_day: @actions.plan_day
                with "Input:activities" = ...
    actions:
        plan_day:
            description: "Prepare a day plan from the activity rows supplied by the guest coordinator."
            inputs:
                "Input:activities": string
                    description: "Activity rows, forwarded unchanged from the user's supplied text."
                    is_required: True
            outputs:
                promptResponse: string
                    description: "Draft content for the user to review."
                    is_used_by_planner: True
                    is_displayable: True
            target: "generatePromptResponse://Ohm_Plan_Day"
