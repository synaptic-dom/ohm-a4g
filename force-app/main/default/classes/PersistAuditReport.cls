/**
 * PersistAuditReport — agent-door invocable action (SPEC §S.11, canon C4/C5, W4).
 * Thin marshaller: deserializes the agent's narratives ([{findingId, narrative, rank}])
 * and delegates to OhmPersistenceService.writeAgentNarratives, which stamps
 * Generated_By__c='Agentforce'. Narratives carry NO numerals (W4) — all figures render
 * exclusively from the deterministic Apex DTOs.
 */
public with sharing class PersistAuditReport {

    @InvocableMethod(
        label='Persist Audit Narratives'
        description='Writes the agent-authored narrative for each finding back onto the audit report. Pass the report Id and a JSON array of {findingId, narrative, rank}. Narratives must contain no numbers — all figures come from the deterministic estimate. Returns how many findings were updated.'
    )
    public static List<Response> run(List<Request> requests) {
        List<Response> out = new List<Response>();
        if (requests == null || requests.isEmpty()) {
            return out;
        }

        // Agentforce invokes with one Request per call; the persistence service owns the
        // bulk update DML for each request's narrative list.
        OhmPersistenceService persistence = new OhmPersistenceService();

        for (Request r : requests) {
            Response resp = new Response();
            try {
                if (r == null || String.isBlank(r.reportId)) {
                    resp.summary = 'Error: reportId is required.';
                    out.add(resp);
                    continue;
                }
                if (String.isBlank(r.narrativesJson)) {
                    resp.recordsUpdated = 0;
                    resp.summary = 'No narratives supplied — nothing was written.';
                    out.add(resp);
                    continue;
                }
                List<OhmDTO.AgentNarrativeInput> narratives =
                    (List<OhmDTO.AgentNarrativeInput>) JSON.deserialize(
                        r.narrativesJson, List<OhmDTO.AgentNarrativeInput>.class);

                Integer updated = persistence.writeAgentNarratives(Id.valueOf(r.reportId.trim()), narratives);
                resp.recordsUpdated = updated;
                resp.summary = 'Wrote ' + updated + ' agent narrative(s) onto report ' + r.reportId +
                    ' (Generated By: Agentforce).';
            } catch (Exception e) {
                resp.summary = 'Error: ' + e.getMessage();
            }
            out.add(resp);
        }
        return out;
    }

    public class Request {
        @InvocableVariable(
            label='Report Id'
            description='Id of the Agent Audit Report whose findings receive the narratives.'
            required=true)
        public String reportId;
        @InvocableVariable(
            label='Narratives JSON'
            description='JSON array of {findingId, narrative, rank}. Narratives must contain no numerals.'
            required=false)
        public String narrativesJson;
    }

    public class Response {
        @InvocableVariable(label='Records Updated' description='Number of findings whose narrative was written.')
        public Integer recordsUpdated;
        @InvocableVariable(label='Summary' description='Natural-language result of the persistence step.')
        public String summary;
    }
}
